{
  "name": "icy-qqbot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "极简 QQ 官方机器人内核：只做协议接入、事件归一化与插件宿主",
  "exports": {
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "smoke": "node scripts/smoke.mjs",
    "app-smoke": "node scripts/app-smoke.mjs",
    "agent-smoke": "node scripts/agent-smoke.mjs",
    "agent-flow-smoke": "node --experimental-sqlite scripts/agent-flow-smoke.mjs",
    "persona-smoke": "node --experimental-sqlite scripts/persona-smoke.mjs",
    "web-settings-smoke": "node --experimental-sqlite scripts/web-settings-smoke.mjs",
    "plugins-smoke": "node --experimental-sqlite scripts/plugins-smoke.mjs",
    "humanize-smoke": "node --experimental-sqlite scripts/humanize-smoke.mjs",
    "group-commands-smoke": "node --experimental-sqlite scripts/group-commands-smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "verify": "npm run typecheck && npm run build && npm run smoke && npm run app-smoke && npm run agent-smoke && npm run agent-flow-smoke && npm run persona-smoke && npm run web-settings-smoke && npm run plugins-smoke && npm run humanize-smoke && npm run group-commands-smoke && npm run e2e"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}

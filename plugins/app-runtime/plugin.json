{
  "name": "app-runtime",
  "version": "0.1.0",
  "entry": "index.ts",
  "runtime": {
    "command": "node",
    "args": [
      "--experimental-strip-types",
      "--experimental-sqlite"
    ]
  },
  "intents": [
    "GROUP_AND_C2C_EVENT"
  ],
  "events": [
    "GROUP_AT_MESSAGE_CREATE",
    "GROUP_MESSAGE_CREATE",
    "C2C_MESSAGE_CREATE"
  ],
  "capabilities": [
    "message.reply"
  ],
  "config": {
    "groupMentionId": "A240AF414EE0AB646FBBF695BB9EA16C",
    "modules": [
      {
        "path": "../../dist/modules/llm/module.js",
        "config": {
          "models": [
            {
              "alias": "hiagent-chat",
              "provider": "hiagent",
              "model": "deepseek-v4.1-flash",
              "baseUrl": "https://asakuraaoi.cn/hiagent/v1",
              "apiKeyEnv": "HIAGENT_GATEWAY_API_KEY",
              "contextTokens": 32000,
              "maxOutputTokens": 512,
              "supportsTools": true,
              "timeoutMs": 90000,
              "outputTokenParameter": "max_tokens",
              "maxPayloadBytes": 180000,
              "maxTextChars": 1400
            }
          ]
        }
      },
      {
        "path": "../../dist/modules/agent/policy.js",
        "config": {
          "allowedGroups": [
            "770C9F010645445AE0351FBBB8B90C49"
          ],
          "enabledTools": [
            "calculator_evaluate"
          ],
          "allowC2c": true
        }
      },
      {
        "path": "../../dist/modules/persona/module.js",
        "config": {
          "defaultId": "assistant",
          "profiles": [
            {
              "id": "assistant",
              "name": "默认助手",
              "description": "自然、简洁地回答问题",
              "systemPrompt": "你是 ICY 机器人。使用自然、简洁的中文回答；不确定时明确说明，不编造事实。可以使用系统提供的工具，但不要声称执行了实际未执行的操作。"
            }
          ],
          "groupAssignments": {},
          "c2cAssignments": {}
        }
      },
      "../../dist/modules/agent/tools-module.js",
      {
        "path": "../../dist/modules/agent/tools-basic.js",
        "config": {
          "knowledge": []
        }
      },
      {
        "path": "../../dist/modules/plugin-writer/module.js",
        "config": {}
      },
      "../../dist/modules/agent/engine-module.js",
      {
        "path": "../../dist/modules/humanize/module.js",
        "config": {
          "enabled": true,
          "stripTerminalPunctuation": true,
          "perLine": true,
          "includeCommands": false
        }
      },
      {
        "path": "../../dist/modules/agent-runtime/runs.js",
        "config": {
          "outputLimit": 512,
          "enabled": true,
          "maxQueue": 2,
          "maxToolCalls": 2,
          "modelAlias": "hiagent-chat",
          "maxConcurrency": 1,
          "maxModelCalls": 3,
          "dbPath": "/var/lib/icy/agent/state.sqlite",
          "runTimeoutMs": 210000
        }
      },
      "../../dist/modules/agent-chat/commands.js",
      {
        "path": "../../dist/modules/agent-chat/module.js",
        "config": {
          "enabled": true
        }
      },
      "../../dist/modules/commands/module.js",
      {
        "path": "../../dist/modules/utility/module.js",
        "config": {
          "enabled": true,
          "maxDice": 20
        }
      },
      {
        "path": "../../dist/modules/memory/module.js",
        "config": {
          "enabled": true,
          "maxEntries": 20,
          "maxChars": 300,
          "dbPath": "/var/lib/icy/plugins/memory.sqlite"
        }
      },
      {
        "path": "../../dist/modules/auto-reply/module.js",
        "config": {
          "enabled": false,
          "rules": []
        }
      }
    ],
    "groupCommandsWithoutMention": true
  },
  "priority": 200
}

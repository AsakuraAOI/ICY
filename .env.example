# QQ 开放平台机器人应用凭证
# 控制台：https://q.qq.com/  →  机器人管理端
QQ_APP_ID=
QQ_APP_SECRET=

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 插件目录（相对仓库根）
PLUGIN_DIR=./plugins

# OpenAPI 基址覆盖，留空即用 https://api.bot.qq.com
# 本地端到端自检（npm run e2e）会由脚本自行注入，不需要手改这里
QQ_API_BASE=

# 主动消息（host/send）频控：滑动窗口
# 被动回复有平台兜底的 5 分钟 / 5 次窗口，主动消息没有，只能由内核拦
QQ_SEND_PER_CONVERSATION=4
QQ_SEND_GLOBAL=20
QQ_SEND_WINDOW_MS=60000
